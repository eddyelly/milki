{
  // Generated by `npx tsc --init`, then tuned for Fabric chaincode (CommonJS on fabric-nodeenv:2.5 / Node 22).
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "rootDir": ".",
    "outDir": ".build",
    "types": ["node", "mocha"],
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // fabric-contract-api builds contract metadata from legacy decorators + design-time types.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
